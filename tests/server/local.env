MERGIN_BASE_URL=http://127.0.0.1:5000
CONTACT_EMAIL=admin@example.com
FLASK_APP=application
FLASK_DEBUG=0
MAINTENANCE_FILE=/data/MAINTENANCE
TEMP_DIR=/data/tmp
DB_HOST=mm-db
DB_PASSWORD=postgres
DB_PORT=5432
SECRET_KEY=local-test-secret
SECURITY_BEARER_SALT=local-bearer-salt
SECURITY_EMAIL_SALT=local-email-salt
SECURITY_PASSWORD_SALT=local-password-salt
SECURITY_UNLOCK_SALT=local-unlock-salt
MAIL_SUPPRESS_SEND=1
LOCAL_PROJECTS=/data
USE_X_ACCEL=0
GEODIFF_WORKING_DIR=/data/geodiff
GEODIFF_LOGGER_LEVEL=2
BROKER_URL=redis://merginmaps-redis:6379/0
BROKER_TRANSPORT_OPTIONS={ 'master_name': 'mymaster' }
CELERY_RESULT_BACKEND=redis://merginmaps-redis:6379/0
ACCOUNT_EXPIRATION=1
GLOBAL_STORAGE=10737418240
PORT=5000
GEVENT_WORKER=True
NO_MONKEY_PATCH=False
DIAGNOSTIC_LOGS_URL=
DIAGNOSTIC_LOGS_DIR=/tmp
OTEL_ENABLED=0
COLLECT_STATISTICS=0
GLOBAL_WORKSPACE=mergin
GLOBAL_WRITE=True
